# ====== Agent IA Forex — configuration (copier en .env, ne jamais commiter .env) ======

# --- Exécution ---
FXA_BROKER=mt5                      # mt5 | paper (simulation sur données historiques réelles)
FXA_MT5_LOGIN=12345678
FXA_MT5_PASSWORD=change-me
FXA_MT5_SERVER=MetaQuotes-Demo
FXA_MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
FXA_MT5_SYMBOL_SUFFIX=              # ex. ".a" ou "m" selon le broker
FXA_ALLOW_LIVE_ACCOUNT=false        # garde-fou : refuse tout compte RÉEL tant que false

# --- Marchés et boucle ---
FXA_SYMBOLS=["EURUSD","GBPUSD","USDJPY","AUDUSD","USDCAD","USDCHF","EURJPY","GBPJPY","XAUUSD"]
FXA_ENTRY_TF=H1
FXA_LOOP_SECONDS=20

# --- Modes au premier démarrage (modifiables à chaud : app / Telegram) ---
FXA_MODE=manual                     # manual | auto
FXA_AUTO_TRADING=false

# --- Modèle ---
# Par défaut seule une version VALIDÉE (critères hors échantillon) est chargée.
# true = autorise la dernière version même non validée -> compte DÉMO / paper uniquement (refusé avec un compte réel)
FXA_ALLOW_UNVALIDATED_MODEL=false

# --- Telegram (créer un bot avec @BotFather, récupérer votre chat_id avec @userinfobot) ---
FXA_TELEGRAM_TOKEN=
FXA_TELEGRAM_CHAT_IDS=[123456789]
FXA_TELEGRAM_PIN=                   # optionnel : PIN exigé pour /pause /resume /mode /auto /stop /close

# --- Application Web ---
FXA_API_HOST=127.0.0.1              # derrière Caddy (HTTPS) ; 0.0.0.0 seulement si nécessaire
FXA_API_PORT=8000
FXA_API_USER=admin
FXA_API_PASSWORD=change-me-long-password
FXA_JWT_SECRET=                     # vide = généré et conservé en base
FXA_DB_URL=sqlite:///data/agent.db

# --- Quantower (bridge C#) ---
FXA_QUANTOWER_TOKEN=change-me-random-token
FXA_QUANTOWER_SYMBOL_MAP={"EURUSD":"6E","GBPUSD":"6B","USDJPY":"6J","AUDUSD":"6A","USDCAD":"6C","USDCHF":"6S","XAUUSD":"GC"}

# --- Calendrier économique ---
FXA_CALENDAR_ENABLED=true
FXA_NEWS_BLOCK_MINUTES=30

# --- Gestion de position ---
FXA_BE_TRIGGER_R=1.0
FXA_BE_LOCK_R=0.1

# --- Sauvegardes ---
FXA_BACKUP_DIR=backups
FXA_BACKUP_EVERY_HOURS=24
